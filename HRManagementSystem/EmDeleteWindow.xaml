<Window x:Class="JMIctprg432.EmDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JMIctprg432"
        mc:Ignorable="d"
        Title="EmDeleteWindow" Height="200" Width="320">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="15"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        <Label Grid.Column="1" Content="EMPLOYEE ID" HorizontalAlignment="Right" Margin="0,0,10,0" Grid.Row="1" VerticalAlignment="Center" FontWeight="Bold" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Width="110"/>
        <Label x:Name="LabelName" Grid.Column="2" Content="" HorizontalAlignment="Right" Margin="0,0,10,0" Grid.Row="2" VerticalAlignment="Center" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="140" Background="#FFE6E6EA"/>
        <TextBox x:Name="TextboxID" Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,75,0" Grid.Row="1" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Height="25" Width="75" HorizontalContentAlignment="Right"/>
        <Label Grid.Column="1" Content="EMPLOYEE NAME" HorizontalAlignment="Right" Margin="0,0,10,0" Grid.Row="2" VerticalAlignment="Center" FontWeight="Bold" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Width="110"/>
        <Label Grid.Column="1" Content="PASSWORD" HorizontalAlignment="Right" Margin="0,0,10,0" Grid.Row="3" VerticalAlignment="Center" FontWeight="Bold" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Width="110"/>
        <TextBox x:Name="TextboxPassword" Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,10,0" Grid.Row="3" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Height="25" Width="140" HorizontalContentAlignment="Right"/>
        <Button x:Name ="ButtonSearch" Content="SEARCH" Grid.Column="2" Margin="0,0,10,0" Grid.Row="1" Height="25" Width ="60" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="10" Background="#FFB4F6A0" Click="ButtonSearch_Click"/>
        <Button x:Name ="ButtonConfirm" Content="CONFIRM" Grid.Column="2" Margin="0,0,10,0" Grid.Row="4" Height="25" Width ="140" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="10" Background="#FFB4F6A0" Click="ButtonConfirm_Click"/>
        
    </Grid>
</Window>
