<Window x:Class="JMIctprg432.InfoBranchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JMIctprg432"
        mc:Ignorable="d"
        Title="InfoBranchWindow" Height="800" Width="600">
    <Grid Background="#FFF2EAD9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="1.6666*"/>
            <ColumnDefinition Width="1.6666*"/>
            <ColumnDefinition Width="1.6666*"/>
            <ColumnDefinition Width="15"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="0.3*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="15"/>
        </Grid.RowDefinitions>


        <DataGrid x:Name="DatagridBranch" Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="2" Grid.RowSpan="3" Margin="0,0,0,10" d:ItemsSource="{d:SampleData ItemCount=5}" AlternatingRowBackground="#FFE4E4F3"/>
        <DataGrid x:Name="DatagridStaff" Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="7" Grid.RowSpan="4" Margin="0,0,0,10" d:ItemsSource="{d:SampleData ItemCount=5}" AlternatingRowBackground="#FFE4E4F3"/>
        <Label Grid.Column="2" Grid.ColumnSpan="3" Content="BRANCH INFORMATION" HorizontalAlignment="Left" Margin="0,0,0,0" Grid.Row="1" VerticalAlignment="Center" FontSize="40" FontWeight="Black">
            <Label.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FF1854F8" Offset="1"/>
                </LinearGradientBrush>
            </Label.Foreground>
        </Label>

        <Label Grid.Column="2" Grid.ColumnSpan="3" Content="STAFF MEMBERS" HorizontalAlignment="Left" Margin="0,0,0,0" Grid.Row="6" VerticalAlignment="Center" FontSize="35" FontWeight="Bold"/>

        <Label Grid.Column="3" Content="BRANCH" HorizontalAlignment="Right" Margin="0,0,10,0" Grid.Row="11" VerticalAlignment="Top" FontSize="18" FontWeight="Bold" HorizontalContentAlignment="Right" Width="126"/>
        <ComboBox x:Name="ComboboxBranch" Grid.Column="1" Grid.ColumnSpan="4" HorizontalAlignment="Right" Grid.Row="11" Width="180" Height="40" VerticalAlignment="Center" FontSize="18" VerticalContentAlignment="Center" Margin="85,0,0,0" SelectionChanged="ComboboxBranch_SelectionChanged">
            <ComboBoxItem Name="Branch0" Content="[0] Not Assigned" FontSize="15"/>
            <ComboBoxItem Name="Branch1" Content="[1] Corporate" FontSize="15"/>
            <ComboBoxItem Name="Branch2" Content="[2] Scranton" FontSize="15"/>
            <ComboBoxItem Name="Branch3" Content="[3] Stamford" FontSize="15"/>
        </ComboBox>

    </Grid>
</Window>
